{
  "name": "jxscout-vscode",
  "displayName": "jxscout-vscode",
  "description": "jxscout extension for VSCode",
  "repository": {
    "type": "git",
    "url": "https://github.com/jxscout/jxscout-vscode"
  },
  "version": "0.0.5",
  "publisher": "jxscout",
  "engines": {
    "vscode": "^1.92.0"
  },
  "icon": "resources/logo.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "contribViewContainerTitle"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jxscout-sidebar",
          "title": "jxscout",
          "icon": "resources/jxscout.svg"
        }
      ]
    },
    "views": {
      "jxscout-sidebar": [
        {
          "type": "tree",
          "id": "jxscoutAstView",
          "name": "Descriptors",
          "icon": "symbol-structure"
        },
        {
          "type": "tree",
          "id": "jxscoutFindingsView",
          "name": "Findings",
          "icon": "shield"
        },
        {
          "type": "tree",
          "id": "jxscoutBookmarksView",
          "name": "Bookmarks",
          "icon": "bookmark"
        },
        {
          "type": "tree",
          "id": "jxscoutFileView",
          "name": "File Explorer",
          "icon": "files"
        }
      ]
    },
    "commands": [
      {
        "command": "jxscout.toggleScope",
        "title": "Toggle project/file scope",
        "icon": "$(list-tree)"
      },
      {
        "command": "jxscout.navigateToMatch",
        "title": "Navigate to match",
        "icon": "$(arrow-right)"
      },
      {
        "command": "jxscout.copyValues",
        "title": "Copy values",
        "icon": "$(copy)"
      },
      {
        "command": "jxscout.copyPaths",
        "title": "Copy paths",
        "icon": "$(copy)"
      },
      {
        "command": "jxscout.copyHostnames",
        "title": "Copy hostnames",
        "icon": "$(copy)"
      },
      {
        "command": "jxscout.copyQueryParams",
        "title": "Copy query params",
        "icon": "$(copy)"
      },
      {
        "command": "jxscout.toggleSortMode",
        "title": "Toggle sort mode",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "jxscout.cycleMatchFilter",
        "title": "Cycle match filter (all/unseen/interesting)",
        "icon": "$(filter)"
      },
      {
        "command": "jxscout.markInteresting",
        "title": "Mark as interesting",
        "icon": "$(star)"
      },
      {
        "command": "jxscout.resetMatchStates",
        "title": "Reset seen/interesting states"
      },
      {
        "command": "jxscout.createFindingFromMatches",
        "title": "Create finding from selection",
        "icon": "$(shield-add)"
      },
      {
        "command": "jxscout.bookmarkMatch",
        "title": "Bookmark match",
        "icon": "$(bookmark)"
      },
      {
        "command": "jxscout.deleteBookmark",
        "title": "Delete bookmark",
        "icon": "$(trash)"
      },
      {
        "command": "jxscout.copyFindingDescription",
        "title": "Copy finding description",
        "icon": "$(copy)"
      },
      {
        "command": "jxscout.filterFindings",
        "title": "Filter findings by severity",
        "icon": "$(filter)"
      },
      {
        "command": "jxscout.refreshFindings",
        "title": "Refresh findings",
        "icon": "$(refresh)"
      },
      {
        "command": "jxscout.refreshBookmarks",
        "title": "Refresh bookmarks",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jxscout.toggleScope",
          "when": "view == jxscoutAstView",
          "group": "navigation"
        },
        {
          "command": "jxscout.toggleScope",
          "when": "view == jxscoutFileView",
          "group": "navigation"
        },
        {
          "command": "jxscout.toggleSortMode",
          "when": "view == jxscoutAstView",
          "group": "navigation"
        },
        {
          "command": "jxscout.cycleMatchFilter",
          "when": "view == jxscoutAstView",
          "group": "navigation"
        },
        {
          "command": "jxscout.filterFindings",
          "when": "view == jxscoutFindingsView",
          "group": "navigation"
        },
        {
          "command": "jxscout.refreshFindings",
          "when": "view == jxscoutFindingsView",
          "group": "navigation"
        },
        {
          "command": "jxscout.refreshBookmarks",
          "when": "view == jxscoutBookmarksView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jxscout.copyValues",
          "when": "view == jxscoutAstView",
          "group": "1_modification"
        },
        {
          "command": "jxscout.copyPaths",
          "when": "view == jxscoutAstView",
          "group": "1_modification"
        },
        {
          "command": "jxscout.copyQueryParams",
          "when": "view == jxscoutAstView",
          "group": "1_modification"
        },
        {
          "command": "jxscout.copyHostnames",
          "when": "view == jxscoutAstView",
          "group": "1_modification"
        },
        {
          "command": "jxscout.bookmarkMatch",
          "when": "view == jxscoutAstView && viewItem == match",
          "group": "2_bookmark"
        },
        {
          "command": "jxscout.markInteresting",
          "when": "view == jxscoutAstView && viewItem == match",
          "group": "2_bookmark"
        },
        {
          "command": "jxscout.createFindingFromMatches",
          "when": "view == jxscoutAstView && viewItem == match",
          "group": "3_findings"
        },
        {
          "command": "jxscout.deleteBookmark",
          "when": "view == jxscoutBookmarksView && viewItem == bookmark",
          "group": "1_modification"
        },
        {
          "command": "jxscout.copyFindingDescription",
          "when": "view == jxscoutFindingsView && viewItem == finding",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "jxscout",
      "properties": {
        "jxscout.serverHost": {
          "type": "string",
          "default": "localhost",
          "description": "Hostname where jxscout is running"
        },
        "jxscout.serverPort": {
          "type": "number",
          "default": 3333,
          "description": "Port where jxscout is running"
        },
        "jxscout.apiToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token for the jxscout HTTP API"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test --experimental-strip-types test/*.test.mts"
  },
  "dependencies": {
    "uuid": "^9.0.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.92.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.23.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2"
  }
}
